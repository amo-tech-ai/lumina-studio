{
  "$comment": "IPI-920 · ONB2-INT-001g — shared brand-URL identity matrix. Asserted by supabase/functions/_shared/brand-url.test.ts (Deno) AND app/src/lib/brand/brand-url.ssot.test.ts (Vitest). Both runtimes must agree on every row.",
  "accepts": [
    { "raw": "https://example.com", "origin": "https://example.com", "why": "bare origin" },
    { "raw": "https://example.com/", "origin": "https://example.com", "why": "trailing slash stripped" },
    { "raw": "https://example.com/shop", "origin": "https://example.com", "why": "path stripped" },
    { "raw": "https://example.com/shop?utm=1&token=secret", "origin": "https://example.com", "why": "query stripped — tokens never enter identity" },
    { "raw": "https://example.com/a#frag", "origin": "https://example.com", "why": "hash stripped" },
    { "raw": "https://Example.COM/Path/", "origin": "https://example.com", "why": "uppercase host lowercased" },
    { "raw": "  https://ok.com  ", "origin": "https://ok.com", "why": "surrounding whitespace trimmed" },
    { "raw": "http://brand.example/collections", "origin": "http://brand.example", "why": "http allowed" },
    { "raw": "https://example.com:443/x", "origin": "https://example.com", "why": "default https port dropped" },
    { "raw": "http://example.com:80/x", "origin": "http://example.com", "why": "default http port dropped" },
    { "raw": "https://example.com:8443/x", "origin": "https://example.com:8443", "why": "non-default port kept — different origin" },
    { "raw": "https://shop.example.com", "origin": "https://shop.example.com", "why": "subdomain is its own origin" },
    { "raw": "https://www.example.com", "origin": "https://www.example.com", "why": "www NOT collapsed to apex (product has not asked for it)" }
  ],
  "rejects": [
    { "raw": "", "why": "empty" },
    { "raw": "   ", "why": "whitespace only" },
    { "raw": "not-a-url", "why": "unparseable" },
    { "raw": "example.com", "why": "no scheme" },
    { "raw": "ftp://bad.com", "why": "non-http(s) scheme" },
    { "raw": "javascript:alert(1)", "why": "non-http(s) scheme" },
    { "raw": "file:///etc/passwd", "why": "non-http(s) scheme" },
    { "raw": "https://exa mple.com", "why": "whitespace inside URL" },
    { "raw": "https://example.com/my page", "why": "whitespace inside path" },
    { "raw": "http://localhost/", "why": "localhost" },
    { "raw": "http://localhost:3000", "why": "localhost with port" },
    { "raw": "https://127.0.0.1/", "why": "IPv4 loopback" },
    { "raw": "https://10.0.0.1/", "why": "private 10/8" },
    { "raw": "https://172.16.0.1/", "why": "private 172.16/12" },
    { "raw": "https://192.168.1.1/", "why": "private 192.168/16" },
    { "raw": "https://169.254.169.254/", "why": "link-local metadata endpoint" },
    { "raw": "https://100.64.0.1/", "why": "CGNAT 100.64/10 low edge" },
    { "raw": "https://100.127.1.1/", "why": "CGNAT 100.64/10 high edge" },
    { "raw": "https://0.0.0.0/", "why": "unspecified IPv4" },
    { "raw": "https://[::]/", "why": "unspecified IPv6" },
    { "raw": "https://[::1]/", "why": "IPv6 loopback" },
    { "raw": "https://[::ffff:127.0.0.1]/", "why": "IPv4-mapped IPv6" },
    { "raw": "https://[fc00::1]/", "why": "IPv6 unique local" },
    { "raw": "https://[fd12::1]/", "why": "IPv6 unique local fd00::/8" },
    { "raw": "https://[fe80::1]/", "why": "IPv6 link-local" },
    { "raw": "https://app.internal/", "why": ".internal host" },
    { "raw": "https://box.local/", "why": ".local host" },
    { "raw": "https://user:pass@example.com/", "why": "embedded credentials" },
    { "raw": "https://user@example.com/", "why": "embedded username" }
  ],
  "sameWebsite": [
    { "a": "https://example.com", "b": "https://example.com/shop?x=1", "same": true },
    { "a": "https://EXAMPLE.com/a", "b": "https://example.com/b#c", "same": true },
    { "a": "https://example.com:443", "b": "https://example.com", "same": true },
    { "a": "https://example.com", "b": "https://www.example.com", "same": false },
    { "a": "https://example.com", "b": "http://example.com", "same": false },
    { "a": "https://a.com", "b": "https://b.com", "same": false },
    { "a": "not-a-url", "b": "not-a-url", "same": false },
    { "a": "https://user:pass@example.com", "b": "https://example.com", "same": false }
  ]
}
