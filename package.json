{
  "name": "ipix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:env": "node scripts/check-client-env.mjs",
    "groq:smoke": "node scripts/groq-smoke.mjs",
    "groq:smoke:test": "node --test scripts/lib/groq-allowlist-sync.test.mjs",
    "groq:baseline": "node scripts/capture-gemini-baseline.mjs",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test e2e/05-mobile-operator-matrix.spec.ts",
    "verify:copilot": "node tasks/copilotkit/verify/verify-copilot.mjs",
    "verify:copilot:test": "node --test tasks/copilotkit/verify/verify-copilot.test.mjs",
    "verify:copilot:selfcheck": "node tasks/copilotkit/classifiers/info-503-threshold.selfcheck.mjs",
    "test:web015": "bash supabase/tests/web015/run.sh",
    "supabase:types": "supabase gen types typescript --linked --schema public,planner,graphql_public > app/src/types/supabase.ts",
    "supabase:migrations": "supabase migration list --linked",
    "supabase:push": "supabase db push --linked",
    "supabase:verify": "node scripts/verify-supabase.mjs",
    "supabase:verify-rls": "node scripts/verify-rls.mjs",
    "supabase:verify-booking-gate": "node scripts/verify-booking-gate.mjs",
    "supabase:ipi-894-materialize-race": "node scripts/ipi-894-materialize-race.mjs",
    "supabase:verify-edge": "node scripts/verify-edge-functions.mjs",
    "supabase:verify-edge-inventory": "node scripts/check-edge-inventory.mjs",
    "supabase:verify-edge-inventory:self-check": "node scripts/check-edge-inventory.mjs --self-check",
    "supabase:verify-brand-intelligence": "node scripts/verify-brand-intelligence.mjs",
    "sync:brand-url": "cp supabase/functions/_shared/brand-url.ts app/src/lib/brand/brand-url.ssot.ts",
    "supabase:verify-edge-unit": "cd supabase/functions && deno test --frozen --allow-env _shared/brand-url.test.ts _shared/bi-groq-guards.test.ts _shared/resolve-caller.test.ts _shared/llm/llm.test.ts _shared/llm/structured.test.ts _shared/llm/cloudflare-client.test.ts brand-intelligence/handler.test.ts audit-asset-dna/handler.test.ts capture-lead/handler.test.ts firecrawl-webhook/handler.test.ts start-brand-crawl/handler.test.ts",
    "supabase:verify-edge-groq": "npm run supabase:verify-edge-unit",
    "seed:sample-brand": "node scripts/seed-sample-brand.mjs",
    "worktree:audit": "node scripts/worktree-audit.mjs",
    "worktree:add": "node scripts/worktree-add.mjs",
    "worktree:health": "node scripts/worktree-health.mjs",
    "worktree:health:all": "node scripts/worktree-health.mjs --all",
    "worktree:pre-delete": "node scripts/worktree-health.mjs --pre-delete",
    "worktree:health:test": "node --test scripts/lib/worktree-health-checks.test.mjs",
    "supabase:verify-planner": "node --experimental-strip-types scripts/verify-planner-scenario.mjs",
    "cloudinary:dry-run-audit": "node scripts/cloudinary-dry-run-audit.mjs",
    "cloudinary:dry-run-audit:test": "node --test scripts/lib/cloudinary-dry-run-audit-lib.test.mjs",
    "scripts:lib:test": "node --test scripts/lib/script-env.test.mjs scripts/lib/check-reporter.test.mjs scripts/lib/pg-ssl.test.mjs scripts/lib/fetch-json.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "cloudinary": "^2.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
